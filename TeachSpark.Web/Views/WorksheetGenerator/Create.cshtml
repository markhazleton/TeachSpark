@model TeachSpark.Web.Services.Models.WorksheetGenerationRequest
@{
    ViewData["Title"] = "Create New Worksheet";
}

<!-- Loading Overlay -->
<div id="loadingOverlay" class="position-fixed top-0 start-0 w-100 h-100 d-none"
    style="background-color:rgba(15,23,42,0.6);z-index:9999;backdrop-filter:blur(4px);">
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="card border-0 shadow-lg text-center" style="min-width:320px;border-radius:1rem;">
            <div class="card-body p-5">
                <div class="spinner-border text-primary mb-3" style="width:3rem;height:3rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="fw-bold mb-1">Generating Your Worksheet</h5>
                <p class="text-muted small mb-3">AI is crafting your personalized content...</p>
                <div class="progress mb-2" style="height:6px;border-radius:3px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                        role="progressbar" style="width:0%" id="progressBar"></div>
                </div>
                <small class="text-muted" id="loadingStatus">Analyzing your content...</small>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">

        <!-- Page Header -->
        <div class="ts-page-header">
            <div>
                <h1 class="page-title"><i class="bi bi-magic me-2 text-primary"></i>Create Worksheet</h1>
                <p class="page-subtitle">Configure your worksheet below and let AI do the heavy lifting.</p>
            </div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>
        </div>

        <form asp-action="Create" method="post" id="worksheetForm">
            <!-- Source Text -->
            <div class="card border-0 mb-4">
                <div class="card-header">
                    <i class="bi bi-file-text me-2 text-primary"></i>Source Text
                </div>
                <div class="card-body p-4">
                    <label asp-for="SourceText" class="form-label">
                        Paste your reading passage <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="SourceText" class="form-control" rows="7"
                        placeholder="Paste your reading passage, story excerpt, or educational text here..."></textarea>
                    <span asp-validation-for="SourceText" class="text-danger small"></span>
                    <div class="form-text mt-2">
                        <i class="bi bi-info-circle me-1"></i>
                        Longer passages work best for reading comprehension; shorter texts are ideal for vocabulary exercises.
                    </div>
                </div>
            </div>

            <!-- Configuration -->
            <div class="card border-0 mb-4">
                <div class="card-header">
                    <i class="bi bi-sliders me-2 text-primary"></i>Worksheet Configuration
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="TemplateId" class="form-label">
                                Template <span class="text-danger">*</span>
                            </label>
                            <select asp-for="TemplateId" asp-items="Model.TemplateOptions" class="form-select" id="templateSelect">
                                <option value="">Select a template...</option>
                            </select>
                            <span asp-validation-for="TemplateId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DifficultyLevel" class="form-label">Difficulty Level</label>
                            <select asp-for="DifficultyLevel" asp-items="Model.DifficultyLevelOptions" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CommonCoreStandardId" class="form-label">Common Core Standard</label>
                            <select asp-for="CommonCoreStandardId" asp-items="Model.CommonCoreStandardOptions" class="form-select">
                                <option value="">No specific standard (optional)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BloomLevelId" class="form-label">Bloom's Taxonomy Level</label>
                            <select asp-for="BloomLevelId" asp-items="Model.BloomLevelOptions" class="form-select"></select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- AI Model -->
            <div class="card border-0 mb-4">
                <div class="card-header">
                    <i class="bi bi-robot me-2 text-primary"></i>AI Model
                </div>
                <div class="card-body p-4">
                    <label asp-for="PreferredLlmModel" class="form-label">
                        Select Model <span class="text-danger">*</span>
                    </label>
                    <select asp-for="PreferredLlmModel" asp-items="Model.AvailableModelOptions"
                        class="form-select mb-2" id="modelSelect" required>
                        <option value="">Select an AI model...</option>
                    </select>
                    <span asp-validation-for="PreferredLlmModel" class="text-danger small"></span>

                    <div id="modelInfo" class="alert alert-info d-none mt-2 py-2">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div>
                                <div class="fw-bold small" id="modelName"></div>
                                <div class="text-muted" style="font-size:0.82rem;" id="modelDescription"></div>
                                <div class="text-muted" style="font-size:0.78rem;" id="modelCapabilities"></div>
                            </div>
                            <div class="d-flex gap-1 flex-shrink-0">
                                <span class="badge bg-primary" id="qualityBadge"></span>
                                <span class="badge bg-success" id="speedBadge"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Generation Options -->
            <div class="card border-0 mb-4">
                <div class="card-header">
                    <i class="bi bi-gear me-2 text-primary"></i>Generation Options
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="MaxQuestions" class="form-label">Number of Questions</label>
                            <input asp-for="MaxQuestions" type="number" class="form-control"
                                min="1" max="@ViewBag.MaxQuestions" id="maxQuestions">
                            <span asp-validation-for="MaxQuestions" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-md-4">
                            <div class="form-check">
                                <input asp-for="IncludeAnswerKey" class="form-check-input" type="checkbox" checked>
                                <label asp-for="IncludeAnswerKey" class="form-check-label fw-semibold">
                                    Include Answer Key
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="CustomInstructions" class="form-label">
                                Custom Instructions <span class="text-muted fw-normal">(optional)</span>
                            </label>
                            <textarea asp-for="CustomInstructions" class="form-control" rows="2"
                                placeholder="Any specific requirements or preferences..."></textarea>
                            <div class="form-text">
                                Example: "Focus on character analysis", "Include vocabulary from the text", "Target 6th grade reading level"
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit -->
            <div class="d-flex justify-content-between align-items-center gap-3">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary btn-lg px-5" id="generateBtn">
                    <span id="normalContent">
                        <i class="bi bi-magic me-2"></i>Generate Worksheet
                    </span>
                    <span id="loadingContent" class="d-none">
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        Generating...
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let availableModels = [];

        document.addEventListener('DOMContentLoaded', function () {
            loadAvailableModels();
        });

        document.getElementById('templateSelect').addEventListener('change', function () {
            updateFormSuggestionsForTemplate(this.value);
            updateModelRecommendations();
        });

        document.getElementById('modelSelect').addEventListener('change', function () {
            updateModelInfo(this.value);
        });

        function loadAvailableModels() {
            fetch('/api/worksheet-generator/models')
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        availableModels = data.data;
                        selectFirstModel();
                    }
                })
                .catch(err => console.error('Error loading models:', err));
        }

        function selectFirstModel() {
            const sel = document.getElementById('modelSelect');
            if (sel.options.length > 1) {
                sel.selectedIndex = 1;
                updateModelInfo(sel.value);
            }
        }

        function updateModelRecommendations() {
            const templateId = document.getElementById('templateSelect').value;
            if (!templateId) return;
            fetch(`/WorksheetGenerator/GetTemplate?id=${encodeURIComponent(templateId)}`)
                .then(r => r.json())
                .then(data => { if (data.success) console.log('Template:', data.data?.templateType); })
                .catch(err => console.error(err));
        }

        function updateModelInfo(modelId) {
            const panel = document.getElementById('modelInfo');
            if (!modelId) { panel.classList.add('d-none'); return; }
            const model = availableModels.find(m => m.id === modelId);
            if (!model) return;

            document.getElementById('modelName').textContent = model.name;
            document.getElementById('modelDescription').textContent = model.description || '';
            const caps = [];
            if (model.supportsStructuredOutput) caps.push('Structured Output');
            if (model.isRecommendedForEducation) caps.push('Education Optimized');
            if (model.strengths?.length) caps.push(...model.strengths);
            document.getElementById('modelCapabilities').textContent = caps.length ? `✓ ${caps.join(' · ')}` : '';
            document.getElementById('qualityBadge').textContent = `Quality ${model.isRecommendedForEducation ? '9' : '7'}/10`;
            document.getElementById('speedBadge').textContent = `Speed ${model.maxTokens > 100000 ? '8' : '6'}/10`;
            panel.classList.remove('d-none');
        }

        function updateFormSuggestionsForTemplate(templateId) {
            if (!templateId) return;
            fetch(`/WorksheetGenerator/GetTemplate?id=${encodeURIComponent(templateId)}`)
                .then(r => r.json())
                .then(data => { if (data.success && data.data) updateFormSuggestions(data.data.templateType); })
                .catch(err => console.error(err));
        }

        function updateFormSuggestions(worksheetType) {
            const suggestions = {
                'reading-comprehension': 'Focus on main idea, supporting details, and inference questions',
                'vocabulary': 'Include context clues, synonyms, antonyms, and word usage exercises',
                'grammar': 'Target specific grammar concepts with clear examples and practice',
                'creative-writing': 'Provide engaging prompts with scaffolding and assessment rubrics',
                'literary-analysis': 'Focus on theme, character development, and literary devices'
            };
            const el = document.getElementById('CustomInstructions');
            if (suggestions[worksheetType]) el.placeholder = suggestions[worksheetType];
        }

        document.getElementById('worksheetForm').addEventListener('submit', function () {
            document.getElementById('loadingOverlay').classList.remove('d-none');
            const btn = document.getElementById('generateBtn');
            btn.disabled = true;
            document.getElementById('normalContent').classList.add('d-none');
            document.getElementById('loadingContent').classList.remove('d-none');

            let progress = 0;
            const messages = ['Analyzing your content...', 'Processing with AI...', 'Generating questions...', 'Formatting worksheet...', 'Almost ready...'];
            const interval = setInterval(() => {
                progress += Math.random() * 15 + 5;
                if (progress >= 95) { progress = 95; clearInterval(interval); }
                document.getElementById('progressBar').style.width = progress + '%';
                document.getElementById('loadingStatus').textContent = messages[Math.min(Math.floor(progress / 20), messages.length - 1)];
            }, 800);
        });
    </script>
}
