@using Microsoft.AspNetCore.Identity
@using TeachSpark.Web.Data.Entities
@using TeachSpark.Web.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-lg-2">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" id="navbarUserDropdown"
                role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white bg-opacity-25"
                    style="width:28px;height:28px;font-size:0.75rem;font-weight:700;color:#fff;">
                    @(UserManager.GetUserName(User)?.Substring(0,1).ToUpper() ?? "U")
                </span>
                <span class="d-none d-lg-inline">@UserManager.GetUserName(User)</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarUserDropdown">
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="bi bi-person-gear me-2"></i>My Profile
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Dashboard">
                        <i class="bi bi-grid-1x2 me-2"></i>Dashboard
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout"
                        asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
            </a>
        </li>
        <li class="nav-item ms-lg-2">
            <a class="btn btn-sm"
                style="background:rgba(255,255,255,0.18);color:#fff;border:1px solid rgba(255,255,255,0.3);border-radius:0.5rem;font-weight:600;padding:0.4rem 1rem;"
                asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus me-1"></i>Get Started
            </a>
        </li>
    }
</ul>
